# Variables d'environnement de la plateforme MT5 Control.
# Ne jamais committer de valeur réelle. Les secrets vivent dans Vercel / systemd.

# ---------------------------------------------------------------- PostgreSQL
# Connexion poolée utilisée par l'application.
DATABASE_URL=postgres://app:change-me@localhost:5432/mt5_platform
# Connexion directe (hors pooler) pour les migrations.
DATABASE_URL_DIRECT=postgres://app:change-me@localhost:5432/mt5_platform
# Taille maximale du pool applicatif (4 Go de RAM sur le VPS).
DATABASE_POOL_MAX=5

# ------------------------------------------------------------ authentification
# Clé aléatoire de 32 octets minimum : openssl rand -base64 48
AUTH_SECRET=
SESSION_COOKIE_NAME=mt5_session
SESSION_TTL_SECONDS=86400
# Origines autorisées pour les mutations (CSRF + CORS) : séparées par des virgules.
ALLOWED_ORIGINS=https://votre-domaine.example,http://localhost:3000

# Premier administrateur (utilisé uniquement par `npm run db:seed`).
# Le mot de passe doit contenir 12 caractères, une majuscule, une minuscule et un chiffre.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------- chiffrement
# Anneau de clés AES-256-GCM, JSON : {"1":"<32 octets en base64>"}.
# La clé la plus élevée chiffre ; les anciennes restent lisibles.
# Génération : node -e "console.log(JSON.stringify({'1':require('crypto').randomBytes(32).toString('base64')}))"
ENCRYPTION_KEY_RING=
SECRET_KEY_ROTATION_DAYS=90

# ------------------------------------------------------- backend <-> moteur MT5
ENGINE_SERVICE_ID=contabo-engine-01
# 32 caractères aléatoires minimum, identiques des deux côtés.
ENGINE_AUTH_SECRET=
COMMAND_TTL_SECONDS=120
ENGINE_HEARTBEAT_SECONDS=15

# --------------------------------------------------------------- mode réel
# false par défaut : la création d'un compte réel est refusée.
ALLOW_REAL_ACCOUNTS=false

# ------------------------------------------------------------------ application
APP_ENV=development
LOG_LEVEL=info

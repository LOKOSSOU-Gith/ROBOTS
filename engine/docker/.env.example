# Configuration mt5-gateway
# Ces variables sont utilisées par docker-compose.yml

# Identifiant du compte MT5
MT5_LOGIN=12345678

# Mot de passe du compte MT5 (investor ou master)
MT5_PASSWORD=your_password_here

# Nom exact du serveur du broker (ex: ICMarketsSC-Demo, Exness-MT5Trial9)
MT5_SERVER=YourBrokerServer

# API key pour l'authentification des requêtes vers mt5-gateway
# Générer avec: openssl rand -base64 32
MT5_GATEWAY_API_KEY=your_api_key_here

# Configuration du moteur Python pour Ubuntu + mt5-gateway

# Backend URL (Next.js)
BACKEND_URL=http://localhost:3000

# Service ID
ENGINE_SERVICE_ID=ubuntu-engine-01

# Secret partagé avec le backend (32+ caractères)
ENGINE_AUTH_SECRET=your_engine_auth_secret_here

# Type de terminal: simulator, windows_bridge, ou mt5_gateway
TERMINAL_KIND=mt5_gateway

# URL du mt5-gateway
MT5_BRIDGE_URL=http://localhost:5001

# API key pour mt5-gateway (32+ caractères)
MT5_GATEWAY_API_KEY=your_gateway_api_key_here

# Timing
ENGINE_HEARTBEAT_SECONDS=15
ENGINE_POLL_SECONDS=2
ENGINE_SCAN_SECONDS=5
COMMAND_TTL_SECONDS=120
ENGINE_COMMAND_MAX_AGE_SECONDS=110
ENGINE_DISCONNECT_SECONDS=60

# Storage
ENGINE_STATE_DIR=./engine-state

# HTTP timeout
ENGINE_HTTP_TIMEOUT_SECONDS=10

# Logging
LOG_LEVEL=INFO
